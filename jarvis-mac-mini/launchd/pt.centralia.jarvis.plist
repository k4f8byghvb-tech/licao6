<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Jarvis da Central IA: arranca com a sessão do Mac mini e volta a arrancar se cair.
     __HOME__ é substituído pelo instalar.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pt.centralia.jarvis</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/Central-IA/bin/jarvis-arrancar.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/Central-IA/jarvis</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/CentralIA/jarvis.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/CentralIA/jarvis.log</string>
</dict>
</plist>
